rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Читать и записывать могут только вошедшие пользователи.
    // Новых пользователей добавляет владелец в разделе Authentication.
    match /{collection}/{docId} {
      allow read, write: if request.auth != null
        && collection in ['animals', 'events', 'finance', 'items', 'moves', 'rations',
                           'pens', 'feedauto', 'milk', 'milkout', 'settings'];
    }
  }
}
